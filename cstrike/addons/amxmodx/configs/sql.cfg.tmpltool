// TheDoctor0 - Base Pack

// SQL configuration file
// File location: $moddir/addons/amxmodx/configs/sql.cfg

// *NOTE* Linux users may encounter problems if they specify "localhost" instead of "127.0.0.1"
// We recommend using your server IP address instead of its name

// *NOTE* amx_sql_type specifies the DEFAULT database type which admin.sma will use.

amx_sql_host    "{{ get_env(name="DB_HOST", default="fill-db-host") }}"
amx_sql_port    "{{ get_env(name="DB_PORT", default="3306") }}"
amx_sql_user    "{{ get_env(name="DB_USER", default="fill-db-user") }}"
amx_sql_pass    "{{ get_env(name="DB_PASSWORD", default="fill-db-password") }}"
amx_sql_db      "{{ get_env(name="DB_NAME"), default="fill-db-name" }}"
amx_sql_table   "amxx_admins"
amx_sql_type    "mysql"
amx_sql_timeout "60"